{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/globals/components/*"
      ],
      "@modals/*": [
        "./src/globals/components/modals/*"
      ],
      "@hooks/*": [
        "./src/globals/hooks/*"
      ],
      "@services/": [
        "./src/globals/services/*"
      ]
    },
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020"
  },
  "include": [
    "src/**/*"
  ]
}